--!strict
-- Optional regular-image backend. The private ID module is generated by static_image_package.py.
local Shared=game:GetService('ReplicatedStorage'):WaitForChild('Shared')
local Cache=require(Shared.Presentation.StaticAssetCache)
local Hash=require(Shared.Presentation.TownLods)
local Provider=game:GetService('ContentProvider')
local data=Shared:FindFirstChild('GameData')
local source=data and data:FindFirstChild('StaticImageIds')
local manifest={}
if source then local ok,result=pcall(require,source);if ok and type(result)=='table'then manifest=result end end
return Cache.new(manifest,{now=os.clock,hash=Hash.signature,content=Content.fromUri,
	start=function(uri,done)
		task.spawn(function()
			local image:ImageLabel?=nil
			local loaded=false
			local ok=pcall(function()
				-- A typed image request selects Roblox's texture loader. Bare URI strings can
				-- report Failure even when that same uploaded Image loads into an ImageLabel.
				image=Instance.new("ImageLabel")
				image.ImageContent=Content.fromUri(uri)
				Provider:PreloadAsync({image},function(_,status)if status==Enum.AssetFetchStatus.Success then loaded=true end end)
			end)
			-- One unparented label exists only for the active preload; no EditableImage is made.
			if image then image:Destroy()end
			done(ok and loaded)
		end)
	end})
