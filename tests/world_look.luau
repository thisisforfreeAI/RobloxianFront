--!strict
return function(test:any,eq:any)
	local Wet=require("../src/shared/Presentation/GroundWetness")
	local Territory=require("../src/shared/Presentation/TerritoryPixels")
	local Screen=require("../src/shared/Presentation/ScreenLight")
	local Fort=require("../src/shared/Presentation/FortificationState")
	test("full cities raise forts, partial garrisons use gate bags, and hidden/ruined states reveal nothing",function()
		eq(Fort.mode({1,1,0,0,1,2,2,"",0,100,0}),"secured")
		eq(Fort.mode({1,1,0,0,1,1,2,"",0,100,0}),"fortified")
		eq(Fort.mode({1,1,0,0,1,0,0,"",0,-1,0}),"none")
		eq(Fort.mode({1,1,0,0,1,2,2,"",0,0,1}),"none")
		eq(Fort.sprite("fort-gate-n","fortified"),"fort-bags-n")
		eq(Fort.sprite("fort-wall-n","fortified"),nil)
		eq(Fort.sprite("fort-wall-n","secured"),"fort-wall-n")
	end)
	test("storm water dries before residual mud and repeated rain restores wetness",function()
		local state={wet=0,mud=0};local timing={riseSec=7.5,drySec=90}
		Wet.advance(state,true,7.5,timing);eq(state.wet,1);eq(state.mud,1)
		Wet.advance(state,false,90,timing);eq(state.wet,0);assert(state.mud>0)
		Wet.advance(state,true,3,timing);assert(state.wet>0)
		Wet.advance(state,false,300,timing);eq(state.wet,0);eq(state.mud,0)
	end)
	test("territory packet keeps complete own claims without exposing unseen enemy claims",function()
		local out=Territory.runs({1,1,2,2,0,0,2,2},4,2,1,function(cell) return cell==3 end)
		eq(table.concat(out,","),"1,0,0,1,2,0,3,3")
		assert(#Territory.runs({1,1,2,2},4,1,0,nil)==8)
	end)
	local fs=require("@lune/fs")
	if not fs.isFile("src/shared/GameData/WorldLook.luau") then return end
	local config=require("../src/shared/GameData/WorldLook") ::any
	test("source night contrast gain uses the original pivot after palette multiplication",function()
		local Daylight=require("../src/shared/Presentation/Daylight")
		local profile=require("../src/shared/GameData/Daylight") ::any
		local noon=Daylight.sample(profile,.31)
		local midnight=Daylight.sample(profile,.81)
		eq(noon.groundGain,1);eq(midnight.groundGain,profile.nightGround.contrast)
		eq(midnight.groundPivot,profile.nightGround.pivot)
		local post=Daylight.postEffect(midnight)
		assert(post.contrast>=0 and post.brightness>=-1 and post.brightness<=1)
	end)
	test("territory wash has clear neutral ground and suppresses built footprints",function()
		local built=buffer.create(32*16);buffer.writeu8(built,8*32+8,1)
		local out=Territory.render({1,0,0,15,1,1,0,15,1,2,0,15,1,3,0,15,1,4,0,15,1,5,0,15,1,6,0,15,1,7,0,15,1,8,0,15,1,9,0,15,1,10,0,15,1,11,0,15,1,12,0,15,1,13,0,15,1,14,0,15,1,15,0,15},32,16,config.territory,config.palette,built)
		eq(buffer.readu8(out,(16*64+16)*4+3),0)
		eq(buffer.readu8(out,(16*64+60)*4+3),0)
		assert(buffer.readu8(out,(16*64+8)*4+3)>0)
	end)
	test("source light wash and vignette produce bounded pixels for noon and midnight",function()
		for _,night in {0,1} do
			local out=Screen.pixels(config,{night=night,golden=0,elevation=1,toward={0,-1},color={1,.93,.78}},64,48)
			eq(buffer.len(out),64*48*4)
			assert(buffer.readu8(out,3)>buffer.readu8(out,(24*64+32)*4+3),"corners darker than centre")
		end
	end)
	test("wet ground fades to transparent and excludes roofs/permanent water",function()
		local field=buffer.create(16*4);local eligible=buffer.create(16)
		for i=0,15 do buffer.writef32(field,i*4,1);buffer.writeu8(eligible,i,2) end
		buffer.writeu8(eligible,0,0)
		local wet=Wet.pixels(field,eligible,4,4,{wet=1,mud=1},config.weather)
		eq(buffer.readu8(wet,3),0);assert(buffer.readu8(wet,7)>0)
		local dry=Wet.pixels(field,eligible,4,4,{wet=0,mud=0},config.weather)
		eq(buffer.tostring(dry),string.rep("\0",64))
	end)
end
