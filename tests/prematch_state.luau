--!strict
return function(test:any,eq:any)
 local State=require("../src/shared/Lobby/PrematchLobbyState")
 local function fixture(policy:any?):any
  return State.new({sessionId="test-room",hostUserId=1,hostName="Host",maps={{id="a",name="Alpha"},{id="b",name="Bravo",seatIds={"one","three"}}},
   seats={{id="one",label="Seat 1",team="Blue"},{id="two",label="Seat 2",team="Red"},{id="three",label="Seat 3",team="Blue"}},policy=policy})
 end
 local function act(s:any,uid:number,kind:string,value:any?):any
  local c={kind=kind,revision=s.snapshot().revision};if kind=="map" then c.mapId=value elseif kind=="seat" then c.seatId=value elseif kind=="ready" then c.ready=value end
  return s.dispatch(uid,c)
 end
 local function prepared():any
  local s=fixture();s.join(2,"Guest");assert(act(s,1,"map","a").ok);assert(act(s,1,"seat","one").ok);assert(act(s,2,"seat","two").ok)
  assert(act(s,1,"ready",true).ok);assert(act(s,2,"ready",true).ok);return s
 end
 test("prematch host chooses only injected maps and unseated players cannot Ready",function()
  local s=fixture();s.join(2,"Guest");eq(act(s,2,"map","a").ok,false);eq(act(s,1,"map","missing").ok,false)
  eq(act(s,1,"ready",true).ok,false);assert(s.snapshot().startFeedback:find("select a map"));assert(act(s,1,"map","a").ok)
 end)
 test("prematch final seat is assigned once and stale commands must review a fresh revision",function()
  local s=fixture();s.join(2,"Guest");act(s,1,"map","a");local revision=s.snapshot().revision
  eq(s.dispatch(1,{kind="seat",seatId="one",revision=revision}).ok,true)
  eq(s.dispatch(2,{kind="seat",seatId="one",revision=revision}).ok,false)
  eq(act(s,2,"seat","one").ok,false);eq(s.snapshot().players["2"].seatId,nil)
 end)
 test("prematch start requires host, map, minimum players, seats, readiness and distinct teams",function()
  local s=prepared();eq(s.snapshot().canStart,true);eq(act(s,2,"start").ok,false)
  act(s,2,"ready",false);eq(s.snapshot().canStart,false);eq(act(s,1,"start").ok,false)
  act(s,2,"seat","three");act(s,1,"ready",true);act(s,2,"ready",true)
  eq(s.snapshot().canStart,false);assert(s.snapshot().startFeedback:find("different teams"))
 end)
 test("prematch host readiness is required and player Ready toggles are explicit booleans",function()
  local s=prepared();act(s,1,"ready",false);eq(s.snapshot().canStart,false)
  eq(act(s,1,"ready","true").ok,false);act(s,1,"ready",true);eq(s.snapshot().canStart,true)
 end)
 test("prematch map changes clear incompatible seats and default readiness",function()
  local s=prepared();act(s,1,"map","b");local v=s.snapshot()
  eq(v.players["2"].seatId,nil);eq(v.players["1"].ready,false);eq(v.players["2"].ready,false)
  eq(act(s,2,"seat","two").ok,false)
 end)
 test("prematch joins and departures reset readiness and release seats",function()
  local s=prepared();s.join(3,"Third");eq(s.snapshot().players["1"].ready,false);s.leave(2)
  eq(s.snapshot().players["2"],nil);eq(act(s,3,"seat","two").ok,true)
 end)
 test("prematch duplicate join does not reset a player's seat or Ready",function()
  local s=prepared();local revision=s.snapshot().revision;s.join(2,"NewName");eq(s.snapshot().revision,revision);eq(s.snapshot().players["2"].ready,true)
 end)
 test("prematch default host disconnect closes the session and refuses commands",function()
  local s=prepared();s.leave(1);eq(s.snapshot().phase,"closed");eq(act(s,2,"ready",true).ok,false);eq(s.join(4,"Late").ok,false)
 end)
 test("prematch optional host transfer selects earliest remaining join, resetting readiness",function()
  local s=fixture({hostDeparture="transfer"});s.join(9,"First");s.join(2,"Second");s.leave(1)
  eq(s.snapshot().hostUserId,9);eq(s.snapshot().phase,"waiting");eq(act(s,9,"map","a").ok,true)
  s.leave(9);eq(s.snapshot().hostUserId,2);s.leave(2);eq(s.snapshot().phase,"closed")
 end)
 test("prematch start is a single transaction and late completion cannot revive cancelled startup",function()
  local s=prepared();assert(act(s,1,"start").ok);local launch=s.snapshot().launchId
  eq(act(s,1,"start").ok,false);s.leave(2);eq(s.snapshot().phase,"waiting");eq(s.finishStart(launch,true),false)
  s.join(2,"Guest");act(s,2,"seat","two");act(s,1,"ready",true);act(s,2,"ready",true);act(s,1,"start")
  eq(s.finishStart(launch,true),false);eq(s.finishStart(s.snapshot().launchId,true),true);eq(s.snapshot().phase,"started")
 end)
 test("prematch failed startup returns to waiting, resets Ready and permits explicit retry",function()
  local s=prepared();act(s,1,"start");eq(s.finishStart(s.snapshot().launchId,false,"Map load failed. Retry."),true)
  eq(s.snapshot().phase,"waiting");eq(s.snapshot().players["1"].ready,false);assert(s.snapshot().message:find("Map load failed"))
 end)
 test("prematch loading unavailable and error phases reject changes and recover through authority",function()
  local s=prepared()
  for _,phase in {"loading","unavailable","error"} do assert(s.setAvailability(phase,"Please retry"));eq(s.snapshot().canStart,false);eq(act(s,1,"map","a").ok,false) end
  assert(s.setAvailability("waiting"));eq(s.snapshot().players["1"].ready,false)
 end)
 test("prematch policies permit a solo setup without claiming original game parity",function()
  local s=fixture({minPlayers=1,requireAllReady=false,requireDistinctTeams=false});act(s,1,"map","a");act(s,1,"seat","one")
  eq(s.snapshot().canStart,true);eq(act(s,1,"start").ok,true)
 end)
 test("prematch optional no-reset policy retains compatible Ready values on map change",function()
  local s=fixture({resetReadyOnMapChange=false});act(s,1,"map","a");act(s,1,"seat","one");act(s,1,"ready",true);act(s,1,"map","b")
  eq(s.snapshot().players["1"].ready,true)
 end)
 test("prematch unavailable empty map catalog cannot start and snapshots cannot mutate authority",function()
  local s=State.new({sessionId="empty",hostUserId=1,maps={},seats={{id="one",team="Blue"},{id="two",team="Red"}}})
  eq(s.snapshot().phase,"unavailable");eq(s.snapshot().canStart,false)
  local view=s.snapshot();view.players["1"].ready=true;table.insert(view.maps,{id="fake"});eq(s.snapshot().players["1"].ready,false);eq(#s.snapshot().maps,0)
 end)
 test("prematch validates malformed catalogs, unknown actors and full roster",function()
  eq(pcall(State.new,{sessionId="bad",hostUserId=1,maps={{id="a"},{id="a"}},seats={{id="one",team="Blue"},{id="two",team="Red"}}}),false)
  local s=fixture();eq(s.dispatch(99,{kind="start",revision=s.snapshot().revision}).ok,false)
  s.join(2,"Two");s.join(3,"Three");eq(s.join(4,"Four").ok,false);eq(s.join(-1,"Bad").ok,false)
 end)
 test("prematch configurable minimum prevents two ready players starting a three-player room",function()
  local s=fixture({minPlayers=3});s.join(2,"Guest");act(s,1,"map","a");act(s,1,"seat","one");act(s,2,"seat","two");act(s,1,"ready",true);act(s,2,"ready",true)
  eq(s.snapshot().canStart,false);assert(s.snapshot().startFeedback:find("at least 3"));eq(act(s,1,"start").ok,false)
 end)
 test("prematch optional roster and seat reset rules preserve other players' Ready",function()
  local s=fixture({resetReadyOnRosterChange=false,resetReadyOnSeatChange=false});s.join(2,"Guest");act(s,1,"map","a");act(s,1,"seat","one");act(s,2,"seat","two");act(s,1,"ready",true);act(s,2,"ready",true)
  s.join(3,"Third");eq(s.snapshot().players["1"].ready,true);act(s,2,"seat","three");eq(s.snapshot().players["1"].ready,true);eq(s.snapshot().players["2"].ready,false)
 end)
 test("prematch host transfer cancels startup and rejects its late completion",function()
  local s=fixture({hostDeparture="transfer"});s.join(2,"Guest");act(s,1,"map","a");act(s,1,"seat","one");act(s,2,"seat","two");act(s,1,"ready",true);act(s,2,"ready",true);act(s,1,"start")
  local launch=s.snapshot().launchId;s.leave(1);eq(s.snapshot().hostUserId,2);eq(s.snapshot().phase,"waiting");eq(s.finishStart(launch,true),false)
 end)

 test("prematch wire snapshots use string UserId keys even for sparse large accounts",function()
  local s=fixture();s.join(123456789,"Guest");local v=s.snapshot()
  eq(v.players[123456789],nil);eq(v.players["123456789"].userId,123456789)
  for key in v.players do eq(type(key),"string") end
 end)

end
