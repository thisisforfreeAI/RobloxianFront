--!strict
return function(test: any, eq: any)
	local Detail = require("../src/shared/Presentation/TownDetail")
	local Patch = require("../src/shared/Presentation/TownPatch")
	test("zoom hysteresis avoids repeated texture changes around every boundary", function()
		local tier = 0
		for _, entry in { { 2.9, 4 }, { 2.5, 4 }, { 2.3, 4 }, { 2.1, 0 }, { 4.3, 2 }, { 4.0, 2 }, { 3.7, 2 }, { 3.5, 4 }, { 8.1, 1 }, { 7.5, 1 }, { 7.1, 1 }, { 6.9, 2 } } do
			tier = Detail.stride(entry[1], tier); eq(tier, entry[2])
		end
	end)
	test("large zoom jumps reach both ends and reduce detail in both directions", function()
		eq(Detail.stride(30, 0), 1); eq(Detail.stride(0.5, 1), 0)
		eq(Detail.stride(3, 1), 4); eq(Detail.stride(5, 1), 2)
	end)
	test("roof lighting follows separate sun and moon paths without blending across their reset", function()
		eq(Detail.frame(0.31, 0.62, 16), 9)
		eq(Detail.frame(0.81, 0.62, 16), 9)
		eq(Detail.frame(0.62 - 1e-6, 0.62, 16), 17)
		eq(Detail.frame(0.62, 0.62, 16), 1)
		eq(Detail.frame(1.08, 0.62, 16), Detail.frame(0.08, 0.62, 16))
		eq(Detail.frame(-0.001, 0.62, 16), Detail.frame(0.999, 0.62, 16))
	end)
	test("sparse lighting patches are reversible and restore exact transparent RGBA", function()
		local pixels = buffer.fromstring("abcdefghijklmnop")
		local original = buffer.tostring(pixels)
		local patch = buffer.create(16)
		buffer.writeu32(patch, 0, 1); buffer.writeu32(patch, 4, 2)
		buffer.writeu32(patch, 8, 0x01020304); buffer.writeu32(patch, 12, 0xFF0000FF)
		Patch.apply(pixels, patch)
		assert(buffer.tostring(pixels) ~= original)
		eq(buffer.readu32(pixels, 0), buffer.readu32(buffer.fromstring(original), 0))
		eq(buffer.readu32(pixels, 12), buffer.readu32(buffer.fromstring(original), 12))
		Patch.apply(pixels, patch); eq(buffer.tostring(pixels), original)
	end)
	test("corrupt lighting data is rejected before changing any pixels", function()
		local pixels = buffer.fromstring("abcdefghijklmnop")
		local patch = buffer.create(24)
		buffer.writeu32(patch, 0, 0); buffer.writeu32(patch, 4, 1); buffer.writeu32(patch, 8, 0xFFFFFFFF)
		buffer.writeu32(patch, 12, 4); buffer.writeu32(patch, 16, 1)
		assert(not pcall(Patch.apply, pixels, patch))
		eq(buffer.tostring(pixels), "abcdefghijklmnop")
		Patch.apply(pixels, buffer.create(0)); eq(buffer.tostring(pixels), "abcdefghijklmnop")
	end)
end
