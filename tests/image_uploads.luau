--!strict
return function(test:any,eq:any)
	local Queue=require("../src/shared/Presentation/ImageUploads")
	local zero={X=0,Y=0};local size={X=1,Y=1}
	local function pixels(n) local b=buffer.create(4);buffer.writeu32(b,0,n);return b end
	test("upload queue snapshots mutable pixels and coalesces to the latest full image",function()
		local seen={};local q=Queue.new(function(img,x,y,w,h,px) table.insert(seen,{img,buffer.readu32(px,0)}) end,function() return 0 end)
		local image={};local b=pixels(10);q.submit(image,zero,size,b);buffer.writeu32(b,0,11)
		q.step();eq(seen[1][2],10)
		q.submit(image,zero,size,pixels(20));q.submit(image,zero,size,pixels(30));eq(q.count,1);eq(q.bytes,4)
		q.step();eq(seen[2][2],30);eq(q.bytes,0);eq(q.count,0);eq(q.coalesced,1)
	end)
	test("continuous high-priority rewrites cannot starve map coverage or effects",function()
		local now=0;local seen={};local q=Queue.new(function(img) seen[img]=(seen[img] or 0)+1 end,function() return now end)
		q.submit("map",zero,size,pixels(1),{priority=1});q.submit("effects",zero,size,pixels(1),{priority=3})
		for _=1,120 do now+=1/60;q.submit("fog",zero,size,pixels(1),{priority=0});q.step() end
		assert(seen.map and seen.effects and seen.fog);eq(q.count,0)
	end)
	test("each render turn writes only one image and bounded ordered partial regions",function()
		local seen={};local q=Queue.new(function(img,x,y,w,h,px) table.insert(seen,{img,x,buffer.readu32(px,0)}) end,function() return 0 end,{maxWrites=2,maxFrameBytes=8})
		q.submit("a",zero,size,pixels(1),{key="a"});q.submit("a",{X=1,Y=0},size,pixels(2),{key="b"});q.submit("a",{X=2,Y=0},size,pixels(3),{key="c"});q.submit("b",zero,size,pixels(4))
		q.step();eq(#seen,2);eq(seen[1][1],"a");eq(seen[2][1],"a");eq(q.bytes,8)
		q.step();eq(seen[3][2],2);q.step();eq(seen[4][1],"b");eq(q.count,0)
	end)
	test("new full snapshots supersede partial history while later partial edits remain ordered",function()
		local seen={};local q=Queue.new(function(_,x,_y,_w,_h,px) table.insert(seen,{x,buffer.readu32(px,0)}) end,function() return 0 end)
		q.submit("image",zero,size,pixels(1),{key="region"});q.submit("image",zero,size,pixels(2));q.submit("image",{X=1,Y=0},size,pixels(3),{key="other"})
		eq(q.bytes,8);q.step();eq(#seen,2);eq(seen[1][2],2);eq(seen[2][2],3)
	end)
	test("queue bounds reject without losing pending work and reserve capacity for fog",function()
		local q=Queue.new(function() end,function() return 0 end,{maxBytes=8,criticalBytes=4,maxImages=6,maxRegions=2})
		assert(q.submit("a",zero,size,pixels(1)));assert(q.submit("b",zero,size,pixels(2)));eq(q.submit("c",zero,size,pixels(3)),false)
		assert(q.submit("fog",zero,size,pixels(4),{priority=0}));eq(q.bytes,12)
		eq(q.submit("a",{X=1,Y=0},size,pixels(4),{key="more"}),false);eq(q.bytes,12)
		q.step();eq(q.bytes,8);q.step();q.step();eq(q.bytes,0)
	end)
	test("cancelled released and reused images never receive stale writes or callbacks",function()
		local seen,callbacks=0,0;local q=Queue.new(function() seen+=1 end,function() return 0 end)
		q.submit("a",zero,size,pixels(1),{done=function() callbacks+=1 end});q.cancel("a");eq(q.count,0);q.step();eq(seen,0);eq(callbacks,0)
		q.submit("a",zero,size,pixels(2),{key="first",done=function() q.cancel("a");q.submit("a",zero,size,pixels(4)) end})
		q.submit("a",zero,size,pixels(3),{key="second"});q.step();eq(seen,1);q.step();eq(seen,2);eq(q.bytes,0)
	end)
	test("failed writes isolate their image and reentrant completion can enqueue more work",function()
		local failed,done=0,0;local q:any
		q=Queue.new(function(image) if image=="bad" then error("synthetic write failure") end end,function() return 0 end)
		q.submit("bad",zero,size,pixels(1),{key="a",done=function(ok) assert(not ok);failed+=1 end});q.submit("bad",zero,size,pixels(2),{key="b"})
		q.submit("good",zero,size,pixels(3),{done=function(ok) assert(ok);done+=1;q.submit("again",zero,size,pixels(4)) end})
		q.step();eq(failed,1);q.step();eq(done,1);q.step();eq(q.count,0);eq(q.bytes,0);eq(q.failed,1)
	end)
end
